# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Audio Configuration
MAX_AUDIO_SIZE_MB=50
ALLOWED_AUDIO_FORMATS=wav,mp3,m4a,webm,ogg,flac

# LLM Configuration
GPT_MODEL_PRIMARY=gpt-4o
GPT_MODEL_SECONDARY=gpt-4o-mini
WHISPER_MODEL=whisper-1
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=3

# LangSmith Tracing (set to true to enable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=callsense-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Multi-language
DEFAULT_LANGUAGE=auto
SUPPORTED_LANGUAGES=en,es,fr,de,hi,ja,zh,ar,pt,ko
